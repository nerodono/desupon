diff --git a/log/platform.go b/log/platform.go
--- a/log/platform.go
+++ b/log/platform.go
@@ -1,4 +1,22 @@
 package log
+
+import "sync/atomic"
+
+var platformLogLevel atomic.Uint32
+
+func init() {
+	platformLogLevel.Store(uint32(LevelNotice))
+}
+
+// SetPlatformLogLevel limits platform diagnostics before formatting, independently of console output.
+// The process-wide setting survives service reloads and can change while connections are logging.
+func SetPlatformLogLevel(level Level) {
+	platformLogLevel.Store(uint32(level))
+}
+
+func platformLevelEnabled(level Level) bool {
+	return uint32(level) <= platformLogLevel.Load()
+}
 
 type PlatformWriter interface {
 	WriteMessage(level Level, message string)
