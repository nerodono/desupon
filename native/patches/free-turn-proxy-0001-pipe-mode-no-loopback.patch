diff --git a/mobile/pipe.go b/mobile/pipe.go
new file mode 100644
index 0000000..8ac43c6
--- /dev/null
+++ b/mobile/pipe.go
@@ -0,0 +1,41 @@
+package mobile
+
+import (
+	"errors"
+	"net"
+
+	"github.com/samosvalishe/free-turn-proxy/internal/netconn"
+)
+
+// StartPipe запускает релей без tun и локального сокета: хост сам гонит WireGuard-датаграммы через
+// возвращённый net.Conn. Только для Go-кода в том же bind; gobind функцию пропускает.
+func StartPipe(configJSON string, mtu int) (net.Conn, error) {
+	mu.Lock()
+	defer mu.Unlock()
+	if current.Load() != nil {
+		return nil, errors.New("already running")
+	}
+	if mtu <= 0 {
+		mtu = 1280
+	}
+	deviceSide, relaySide := netconn.PacketPipe(mtu+tunnelPipeHeadroom, 0)
+	parts := &tunnelParts{deviceSide: deviceSide, relaySide: relaySide}
+	if err := startLocked(configJSON, 0, false, parts); err != nil {
+		parts.close()
+		return nil, err
+	}
+	return &pipeConn{PacketConn: deviceSide, remote: relaySide.LocalAddr()}, nil
+}
+
+type pipeConn struct {
+	net.PacketConn
+	remote net.Addr
+}
+
+func (c *pipeConn) Read(b []byte) (int, error) {
+	n, _, err := c.ReadFrom(b)
+	return n, err
+}
+
+func (c *pipeConn) Write(b []byte) (int, error) { return c.WriteTo(b, c.remote) }
+func (c *pipeConn) RemoteAddr() net.Addr        { return c.remote }
diff --git a/mobile/pipe_test.go b/mobile/pipe_test.go
new file mode 100644
index 0000000..7927899
--- /dev/null
+++ b/mobile/pipe_test.go
@@ -0,0 +1,46 @@
+package mobile
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestStartPipeRejectsTCPMode(t *testing.T) {
+	t.Cleanup(Stop)
+	const tcpConfig = `{"peer":"1.2.3.4:5000","clientId":"deadbeef","proxy":{"mode":"tcp"},"vk":{"links":["https://vk.ru/call/join/CODE"]}}`
+	if _, err := StartPipe(tcpConfig, 1280); !errors.Is(err, ErrPipeRequiresUDP) {
+		t.Fatalf("StartPipe(tcp) error = %v, want ErrPipeRequiresUDP", err)
+	}
+	if got := GetState().State; got != StateIdle {
+		t.Fatalf("GetState().State = %q after rejected StartPipe, want idle", got)
+	}
+}
+
+func TestStartPipeStopUnblocksReader(t *testing.T) {
+	t.Cleanup(Stop)
+	conn, err := StartPipe(testConfig, 1280)
+	if err != nil {
+		t.Fatalf("StartPipe() error = %v", err)
+	}
+	if conn.RemoteAddr() == nil {
+		t.Fatal("pipe conn has no remote address")
+	}
+	if _, err := StartPipe(testConfig, 1280); err == nil {
+		t.Fatal("second StartPipe() succeeded, want already running")
+	}
+	readErr := make(chan error, 1)
+	go func() {
+		_, err := conn.Read(make([]byte, 2048))
+		readErr <- err
+	}()
+	Stop()
+	select {
+	case err := <-readErr:
+		if err == nil {
+			t.Fatal("Read() after Stop returned nil error")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Read() still blocked after Stop")
+	}
+}
