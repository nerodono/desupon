@@ -0,0 +1,31 @@
+package dnsdial
+
+import (
+	"net"
+	"net/netip"
+	"testing"
+)
+
+func TestDohForwarderDialUsesNoSocket(t *testing.T) {
+	dial := dohForwarderDial(mockDoH(t))
+	for _, network := range []string{"udp", "tcp"} {
+		conn, err := dial(t.Context(), network, "192.0.2.1:53")
+		if err != nil {
+			t.Fatalf("dial %s: %v", network, err)
+		}
+		switch conn.(type) {
+		case *net.UDPConn, *net.TCPConn:
+			t.Fatalf("dial %s returned a kernel socket %T", network, conn)
+		}
+		_ = conn.Close()
+	}
+
+	resolver := newAppDialer(dial).Resolver
+	addrs, err := resolver.LookupNetIP(t.Context(), "ip4", "example.com")
+	if err != nil {
+		t.Fatalf("LookupNetIP: %v", err)
+	}
+	if len(addrs) != 1 || addrs[0] != netip.MustParseAddr("9.9.9.9") {
+		t.Fatalf("LookupNetIP = %v, want [9.9.9.9]", addrs)
+	}
+}
