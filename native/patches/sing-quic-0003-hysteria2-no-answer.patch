diff --git a/hysteria2/answer.go b/hysteria2/answer.go
new file mode 100644
index 0000000..b66257b
--- /dev/null
+++ b/hysteria2/answer.go
@@ -0,0 +1,149 @@
+package hysteria2
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/quic-go"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+var errNoAnswer = E.New("no answer from server")
+
+// minAnswerTimeout keeps short-RTT paths from tripping on a brief stall, such as a radio switching cells.
+const minAnswerTimeout = 5 * time.Second
+
+// minAnswerHardTimeout lets a short outage, a handover or a tunnel, pass before the flows on a connection are cut;
+// it stays at half the 30 s QUIC idle timeout, which would otherwise be the only limit.
+const minAnswerHardTimeout = 15 * time.Second
+
+// answerPTOs covers quic-go's probes at 1, 3 and 7 PTOs after a lost send and the reply to the last one,
+// with room for a peer max_ack_delay above maxAckDelay.
+const answerPTOs = 10
+
+// maxAckDelay assumes quic-go's default for the peer's max_ack_delay, which ConnectionStats does not report.
+const maxAckDelay = 25 * time.Millisecond
+
+// answerPoll is how often a wait checks whether its send has left yet.
+const answerPoll = time.Second
+
+// answerTimeoutFor is how long a live peer may take to acknowledge anything sent to it, from quic-go's own PTO estimate.
+func answerTimeoutFor(stats quic.ConnectionStats, floor time.Duration) time.Duration {
+	pto := stats.SmoothedRTT + max(4*stats.MeanDeviation, time.Millisecond) + maxAckDelay
+	return max(floor, answerPTOs*pto)
+}
+
+func answerHardTimeoutFor(soft time.Duration, floor time.Duration) time.Duration {
+	return max(floor, 2*soft)
+}
+
+// answerWatch follows data sent on a connection until the server is heard from again: past the soft timeout the
+// connection takes no new flows, past the hard one it is closed; quic-go's own idle timer would wait out the idle timeout.
+type answerWatch struct {
+	receive     *receiveTracker
+	timeouts    func() (soft, hard time.Duration)
+	packetsSent func() uint64
+	expire      func(error)
+	poll        time.Duration
+	// waiting is the monotonic time of the first send since the server was last heard from; the wait is open while
+	// it is past receive.lastMono.
+	waiting atomic.Int64
+	// marked is set once an open wait passed the soft timeout; it counts only while that wait stays open.
+	marked atomic.Bool
+
+	access sync.Mutex
+	timer  *time.Timer
+	closed bool
+	// since is where the wait counts from: its start, or the last poll that found nothing sent.
+	since    int64
+	sentBase uint64
+	onWire   bool
+}
+
+func newAnswerWatch(receive *receiveTracker, timeouts func() (soft, hard time.Duration), packetsSent func() uint64, expire func(error)) *answerWatch {
+	return &answerWatch{receive: receive, timeouts: timeouts, packetsSent: packetsSent, expire: expire, poll: answerPoll}
+}
+
+func (w *answerWatch) open() bool {
+	return w.waiting.Load() > w.receive.lastMono.Load()
+}
+
+// unanswered reports a wait past the soft timeout that the server has not answered since.
+func (w *answerWatch) unanswered() bool {
+	return w.marked.Load() && w.open()
+}
+
+// sent marks data handed to quic-go; only the first send of a wait takes the lock.
+func (w *answerWatch) sent() {
+	if w.open() {
+		return
+	}
+	w.access.Lock()
+	defer w.access.Unlock()
+	if w.closed || w.open() {
+		return
+	}
+	now := w.receive.clock().mono
+	w.marked.Store(false)
+	w.since = now
+	w.sentBase = w.packetsSent()
+	w.onWire = false
+	w.waiting.Store(now)
+	w.scheduleLocked(w.poll)
+}
+
+func (w *answerWatch) scheduleLocked(d time.Duration) {
+	if w.timer == nil {
+		w.timer = time.AfterFunc(d, w.fire)
+	} else {
+		w.timer.Reset(d)
+	}
+}
+
+func (w *answerWatch) fire() {
+	w.access.Lock()
+	if w.closed || !w.open() {
+		w.access.Unlock()
+		return
+	}
+	now := w.receive.clock().mono
+	soft, hard := w.timeouts()
+	if !w.onWire {
+		if w.packetsSent() == w.sentBase {
+			// Flow control or congestion still holds the data, so there is nothing a server could have answered.
+			if time.Duration(now-w.waiting.Load()) < hard {
+				w.since = now
+				w.scheduleLocked(w.poll)
+			}
+			// Held past the hard timeout, the wait is left to quic-go's idle timer until the server is heard from.
+			w.access.Unlock()
+			return
+		}
+		w.onWire = true
+	}
+	waited := time.Duration(now - w.since)
+	if waited < soft {
+		w.scheduleLocked(soft - waited)
+		w.access.Unlock()
+		return
+	}
+	w.marked.Store(true)
+	if waited < hard {
+		w.scheduleLocked(hard - waited)
+		w.access.Unlock()
+		return
+	}
+	w.closed = true
+	w.access.Unlock()
+	w.expire(E.Cause(errNoAnswer, "nothing received for ", waited.Round(100*time.Millisecond), " after sending"))
+}
+
+func (w *answerWatch) close() {
+	w.access.Lock()
+	defer w.access.Unlock()
+	w.closed = true
+	if w.timer != nil {
+		w.timer.Stop()
+	}
+}
diff --git a/hysteria2/answer_test.go b/hysteria2/answer_test.go
new file mode 100644
index 0000000..1cd2ae6
--- /dev/null
+++ b/hysteria2/answer_test.go
@@ -0,0 +1,447 @@
+package hysteria2
+
+import (
+	"errors"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/quic-go"
+)
+
+func TestAnswerTimeoutFor(t *testing.T) {
+	for _, testCase := range []struct {
+		name  string
+		stats quic.ConnectionStats
+		want  time.Duration
+	}{
+		{"fast path keeps the floor", quic.ConnectionStats{SmoothedRTT: 80 * time.Millisecond, MeanDeviation: 10 * time.Millisecond}, minAnswerTimeout},
+		{"slow path scales", quic.ConnectionStats{SmoothedRTT: time.Second, MeanDeviation: 250 * time.Millisecond}, answerPTOs * (2*time.Second + maxAckDelay)},
+		{"jitter counts", quic.ConnectionStats{SmoothedRTT: 300 * time.Millisecond, MeanDeviation: 300 * time.Millisecond}, answerPTOs * (1500*time.Millisecond + maxAckDelay)},
+	} {
+		if got := answerTimeoutFor(testCase.stats, minAnswerTimeout); got != testCase.want {
+			t.Errorf("%s: %v, want %v", testCase.name, got, testCase.want)
+		}
+	}
+	if got := answerHardTimeoutFor(minAnswerTimeout, minAnswerHardTimeout); got != minAnswerHardTimeout {
+		t.Errorf("hard timeout on a fast path: %v, want the %v floor", got, minAnswerHardTimeout)
+	}
+	if got := answerHardTimeoutFor(10*time.Second, minAnswerHardTimeout); got != 20*time.Second {
+		t.Errorf("hard timeout on a slow path: %v, want twice the soft one", got)
+	}
+}
+
+type answerProbe struct {
+	clock   *fakeClock
+	tracker *receiveTracker
+	watch   *answerWatch
+	packets atomic.Uint64
+	expired atomic.Int32
+	lastErr atomic.Value
+}
+
+func newAnswerProbe(t *testing.T) *answerProbe {
+	t.Helper()
+	p := &answerProbe{clock: &fakeClock{}}
+	p.tracker = newReceiveTracker(p.clock.read, time.Minute)
+	p.watch = newAnswerWatch(p.tracker, func() (time.Duration, time.Duration) {
+		return 5 * time.Second, 15 * time.Second
+	}, p.packets.Load, func(err error) {
+		p.expired.Add(1)
+		p.lastErr.Store(err)
+	})
+	// Tests drive fire by hand; a long poll keeps the real timer from racing them.
+	p.watch.poll = time.Hour
+	t.Cleanup(p.watch.close)
+	return p
+}
+
+// send hands data to the watch and lets it reach the wire.
+func (p *answerProbe) send() {
+	p.watch.sent()
+	p.packets.Add(1)
+}
+
+func (p *answerProbe) at(d time.Duration) {
+	p.clock.advance(d)
+	p.watch.fire()
+}
+
+func TestAnswerWatchStages(t *testing.T) {
+	p := newAnswerProbe(t)
+	p.clock.advance(time.Second)
+	p.send()
+	start := p.watch.waiting.Load()
+	p.clock.advance(time.Second)
+	p.send()
+	if p.watch.waiting.Load() != start {
+		t.Fatal("a later send moved the start of an unanswered wait")
+	}
+
+	p.at(3900 * time.Millisecond)
+	if p.watch.unanswered() {
+		t.Fatal("marked before the soft timeout")
+	}
+	p.at(100 * time.Millisecond)
+	if !p.watch.unanswered() || p.expired.Load() != 0 {
+		t.Fatal("not marked, or closed, at the soft timeout")
+	}
+
+	p.clock.advance(time.Second)
+	p.tracker.touch()
+	if p.watch.unanswered() {
+		t.Fatal("a reply did not clear the mark")
+	}
+	p.watch.fire()
+	p.clock.advance(time.Millisecond)
+	p.send()
+	if p.watch.unanswered() {
+		t.Fatal("a new wait inherited the old mark")
+	}
+
+	p.at(5 * time.Second)
+	if !p.watch.unanswered() {
+		t.Fatal("second wait not marked at the soft timeout")
+	}
+	p.at(9900 * time.Millisecond)
+	if p.expired.Load() != 0 {
+		t.Fatal("closed before the hard timeout")
+	}
+	p.at(100 * time.Millisecond)
+	if p.expired.Load() != 1 {
+		t.Fatal("unanswered wait not closed at the hard timeout")
+	}
+	if err, _ := p.lastErr.Load().(error); !errors.Is(err, errNoAnswer) {
+		t.Fatal("closed with another error: ", err)
+	}
+	p.watch.fire()
+	p.send()
+	if p.expired.Load() != 1 {
+		t.Fatal("watch acted after it closed")
+	}
+}
+
+func TestAnswerWatchCountsFromTheWire(t *testing.T) {
+	p := newAnswerProbe(t)
+	p.clock.advance(time.Second)
+	// Flow control holds the data: the send returns, but nothing leaves.
+	p.watch.sent()
+	for range 14 {
+		p.at(time.Second)
+	}
+	if p.watch.unanswered() || p.expired.Load() != 0 {
+		t.Fatal("a send that never left was counted as unanswered")
+	}
+	// The window opens, or a keepalive goes out, half a second after the last poll.
+	p.clock.advance(500 * time.Millisecond)
+	p.packets.Add(1)
+	p.at(500 * time.Millisecond)
+	p.at(3500 * time.Millisecond)
+	if p.watch.unanswered() {
+		t.Fatal("marked before the soft timeout counted from the last poll that found nothing sent")
+	}
+	p.at(time.Second)
+	if !p.watch.unanswered() {
+		t.Fatal("data that left and went unanswered was not marked")
+	}
+}
+
+func TestAnswerWatchGivesUpOnHeldData(t *testing.T) {
+	p := newAnswerProbe(t)
+	p.watch.poll = 10 * time.Millisecond
+	p.clock.advance(time.Second)
+	p.watch.sent()
+	p.clock.advance(16 * time.Second)
+	p.watch.fire()
+	time.Sleep(100 * time.Millisecond)
+	if p.watch.timer.Stop() {
+		t.Fatal("polling went on past the hard timeout for data that never left")
+	}
+	if p.expired.Load() != 0 {
+		t.Fatal("held data closed the connection")
+	}
+}
+
+func TestAnswerWatchIdleAndClose(t *testing.T) {
+	var expired atomic.Int32
+	timeouts := func() (time.Duration, time.Duration) { return 20 * time.Millisecond, 40 * time.Millisecond }
+	sentPackets := func() uint64 { return uint64(time.Now().UnixNano()) }
+	idle := newAnswerWatch(newReceiveTracker(coarseClock, time.Minute), timeouts, sentPackets, func(error) {
+		expired.Add(1)
+	})
+	defer idle.close()
+	closed := newAnswerWatch(newReceiveTracker(coarseClock, time.Minute), timeouts, sentPackets, func(error) {
+		expired.Add(1)
+	})
+	closed.poll = 5 * time.Millisecond
+	time.Sleep(time.Millisecond)
+	closed.sent()
+	closed.close()
+	time.Sleep(200 * time.Millisecond)
+	if idle.timer != nil {
+		t.Fatal("a watch that never sent armed a timer")
+	}
+	if expired.Load() != 0 {
+		t.Fatal("a timer fired after close or without a send")
+	}
+	closed.sent()
+	if closed.timer.Stop() {
+		t.Fatal("a send after close rearmed the timer")
+	}
+}
+
+var answerVariants = []struct {
+	name    string
+	options harnessOptions
+}{
+	{"plain", harnessOptions{}},
+	{"salamander", harnessOptions{salamander: "obfs"}},
+	{"gecko", harnessOptions{gecko: "obfs"}},
+	{"hop", harnessOptions{hop: true}},
+}
+
+const (
+	testAnswerSoft = 300 * time.Millisecond
+	testAnswerHard = 1200 * time.Millisecond
+)
+
+func newAnswerHarness(t *testing.T, options harnessOptions) *staleHarness {
+	t.Helper()
+	h := newHarness(t, options)
+	h.client.clock = coarseClock
+	h.client.answerFloor = testAnswerSoft
+	h.client.answerHardFloor = testAnswerHard
+	h.client.answerPoll = 20 * time.Millisecond
+	return h
+}
+
+func waitNoAnswer(t *testing.T, conn *clientQUICConnection, sentAt time.Time) {
+	t.Helper()
+	select {
+	case <-conn.connDone:
+	case <-time.After(testAnswerHard + 5*time.Second):
+		t.Fatal("unanswered connection left open")
+	}
+	if !errors.Is(conn.connErr, errNoAnswer) {
+		t.Fatal("connection closed for another reason: ", conn.connErr)
+	}
+	if waited := time.Since(sentAt); waited < testAnswerHard-100*time.Millisecond {
+		t.Fatalf("closed after %v, before the %v hard timeout", waited, testAnswerHard)
+	}
+}
+
+// waitMarked offers until new flows leave conn, which happens once the soft timeout passed unanswered.
+func waitMarked(t *testing.T, h *staleHarness, conn *clientQUICConnection, sentAt time.Time) *clientQUICConnection {
+	t.Helper()
+	for {
+		if conn.answer.unanswered() {
+			break
+		}
+		if time.Since(sentAt) > testAnswerHard {
+			t.Fatal("not marked before the hard timeout")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if waited := time.Since(sentAt); waited < testAnswerSoft-50*time.Millisecond {
+		t.Fatalf("marked after %v, before the %v soft timeout", waited, testAnswerSoft)
+	}
+	replacement := h.offer(t)
+	if replacement == conn {
+		t.Fatal("new flows kept an unanswered connection")
+	}
+	if !conn.active() {
+		t.Fatal("the soft timeout closed the connection")
+	}
+	return replacement
+}
+
+func TestNoAnswerClosesAfterDatagram(t *testing.T) {
+	for _, variant := range answerVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			h := newAnswerHarness(t, variant.options)
+			conn := h.offer(t)
+			session := h.listen(t)
+			echoPacket(t, session)
+			h.server.silence(conn.quicConn.LocalAddr())
+			sentAt := time.Now()
+			// One send and then only waiting, as an app does after a request.
+			if _, err := session.WriteTo([]byte("ping"), staleEchoDestination.UDPAddr()); err != nil {
+				t.Fatal(err)
+			}
+			replacement := waitMarked(t, h, conn, sentAt)
+			waitNoAnswer(t, conn, sentAt)
+			_ = session.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, _, err := session.ReadFrom(make([]byte, 64)); err == nil || errors.Is(err, os.ErrDeadlineExceeded) {
+				t.Fatal("UDP session outlived its unanswered connection: ", err)
+			}
+			if !replacement.active() {
+				t.Fatal("replacement closed with the unanswered connection")
+			}
+			echoPacket(t, h.listen(t))
+			assertNotRetired(t, h, conn)
+		})
+	}
+}
+
+func TestNoAnswerClosesAfterStreamRequest(t *testing.T) {
+	for _, variant := range answerVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			h := newAnswerHarness(t, variant.options)
+			conn := h.offer(t)
+			echoStream(t, h.dial(t))
+			h.server.silence(conn.quicConn.LocalAddr())
+			stream := h.dial(t)
+			sentAt := time.Now()
+			if _, err := stream.Write([]byte("request")); err != nil {
+				t.Fatal(err)
+			}
+			waitMarked(t, h, conn, sentAt)
+			waitNoAnswer(t, conn, sentAt)
+			_ = stream.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, err := stream.Read(make([]byte, 64)); err == nil || errors.Is(err, os.ErrDeadlineExceeded) {
+				t.Fatal("stream outlived its unanswered connection: ", err)
+			}
+			echoStream(t, h.dial(t))
+			assertNotRetired(t, h, conn)
+		})
+	}
+}
+
+func TestNoAnswerOutageKeepsExistingFlows(t *testing.T) {
+	for _, variant := range answerVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			h := newAnswerHarness(t, variant.options)
+			conn := h.offer(t)
+			stream := h.dial(t)
+			echoStream(t, stream)
+			h.server.silence(conn.quicConn.LocalAddr())
+			sentAt := time.Now()
+			_ = stream.SetDeadline(time.Now().Add(10 * time.Second))
+			if _, err := stream.Write([]byte("hello")); err != nil {
+				t.Fatal(err)
+			}
+			replacement := waitMarked(t, h, conn, sentAt)
+			// The signal comes back before the hard timeout: the old flow resumes, new ones stay on the replacement.
+			h.server.unsilence(conn.quicConn.LocalAddr())
+			buffer := make([]byte, 5)
+			if _, err := stream.Read(buffer); err != nil || string(buffer) != "hello" {
+				t.Fatalf("flow on the connection did not resume after the outage: %q %v", buffer, err)
+			}
+			time.Sleep(testAnswerHard)
+			if !conn.active() {
+				t.Fatal("the connection was closed although the server answered: ", conn.connErr)
+			}
+			if h.offer(t) != replacement {
+				t.Fatal("new flows went back to the retired connection")
+			}
+			_ = stream.Close()
+			select {
+			case <-conn.connDone:
+			case <-time.After(5 * time.Second):
+				t.Fatal("retired connection outlived its last flow")
+			}
+			if errors.Is(conn.connErr, errNoAnswer) {
+				t.Fatal("retired connection closed as unanswered: ", conn.connErr)
+			}
+			assertNotRetired(t, h, conn)
+		})
+	}
+}
+
+func TestNoAnswerKeepsFlowControlBlockedWrite(t *testing.T) {
+	h := newAnswerHarness(t, harnessOptions{})
+	conn := h.offer(t)
+	echoStream(t, h.dial(t))
+	// Three unread streams outgrow the server's connection window, so the client stops sending on every stream.
+	for range 3 {
+		stream, err := h.client.DialConn(h.ctx, staleHoldDestination)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = stream.Close() })
+		go func() { _, _ = stream.Write(make([]byte, 9<<20)) }()
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		before := conn.quicConn.ConnectionStats().PacketsSent
+		time.Sleep(300 * time.Millisecond)
+		if conn.quicConn.ConnectionStats().PacketsSent == before {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("the connection window never ran out")
+		}
+	}
+	// A new flow's request fits the packet buffer, so the write returns although nothing can be sent.
+	stream := h.dial(t)
+	_ = stream.SetWriteDeadline(time.Now().Add(5 * time.Second))
+	if _, err := stream.Write([]byte("request")); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(testAnswerHard + 500*time.Millisecond)
+	if conn.answer.unanswered() || !conn.active() {
+		t.Fatal("a write held by flow control was counted as unanswered: ", conn.connErr)
+	}
+	if h.offer(t) != conn {
+		t.Fatal("new flows left a connection held only by flow control")
+	}
+}
+
+func TestNoAnswerKeepsIdleConnection(t *testing.T) {
+	h := newAnswerHarness(t, harnessOptions{})
+	conn := h.offer(t)
+	echoPacket(t, h.listen(t))
+	h.server.silence(conn.quicConn.LocalAddr())
+	time.Sleep(testAnswerHard + testAnswerSoft)
+	if !conn.active() || h.offer(t) != conn {
+		t.Fatal("idle connection closed or left although nothing was sent")
+	}
+}
+
+func TestNoAnswerKeepsReplyJustInTime(t *testing.T) {
+	h := newAnswerHarness(t, harnessOptions{})
+	conn := h.offer(t)
+	session := h.listen(t)
+	echoPacket(t, session)
+	// The first slow reply meets a soft timeout still at the floor; it lands just before it.
+	h.server.setDelay(testAnswerSoft - 100*time.Millisecond)
+	echoPacket(t, session)
+	if conn.answer.marked.Load() {
+		t.Fatal("a reply within the soft timeout marked the connection")
+	}
+	if !conn.active() || h.offer(t) != conn {
+		t.Fatal("connection to a live server left or closed: ", conn.connErr)
+	}
+}
+
+func TestNoAnswerTimeoutFollowsRTT(t *testing.T) {
+	h := newAnswerHarness(t, harnessOptions{})
+	conn := h.offer(t)
+	session := h.listen(t)
+	echoPacket(t, session)
+	// Raise the delay in steps so the RTT estimate follows, then sit above the floor.
+	for delay := 50 * time.Millisecond; delay <= 2*testAnswerSoft; delay += 50 * time.Millisecond {
+		h.server.setDelay(delay)
+		echoPacket(t, session)
+	}
+	for range 3 {
+		echoPacket(t, session)
+	}
+	if conn.answer.marked.Load() || !conn.active() || h.offer(t) != conn {
+		t.Fatal("a reply slower than the floor but within the RTT-based timeout marked or closed the connection: ", conn.connErr)
+	}
+	if soft, _ := conn.answer.timeouts(); soft <= 2*testAnswerSoft {
+		t.Fatalf("soft timeout %v did not grow with the RTT", soft)
+	}
+}
+
+func assertNotRetired(t *testing.T, h *staleHarness, conn *clientQUICConnection) {
+	t.Helper()
+	h.client.connAccess.Lock()
+	_, retired := h.client.retired[conn]
+	h.client.connAccess.Unlock()
+	if retired {
+		t.Fatal("closed connection still held as retired")
+	}
+}
diff --git a/hysteria2/client.go b/hysteria2/client.go
index 68f97ac..371711c 100644
--- a/hysteria2/client.go
+++ b/hysteria2/client.go
@@ -79,11 +79,16 @@ type Client struct {
 	controlClient      *realm.ControlClient
 	clock              func() clockReading
 	staleAfter         time.Duration
+	answerFloor        time.Duration
+	answerHardFloor    time.Duration
+	answerPoll         time.Duration
 
 	connAccess sync.Mutex
 	conn       *clientQUICConnection
-	closeIdle  atomic.Bool
