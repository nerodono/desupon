new file mode 100644
index 0000000..d39ef7d
--- /dev/null
+++ b/hysteria2/answer.go
@@ -0,0 +1,110 @@
+package hysteria2
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/quic-go"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+var errNoAnswer = E.New("no answer from server")
+
+// minAnswerTimeout keeps short-RTT paths from tripping on a brief stall, such as a radio switching cells.
+const minAnswerTimeout = 5 * time.Second
+
+// answerPTOs covers quic-go's probes at 1, 3 and 7 PTOs after a lost send, plus the round trip of the reply to the last one.
+const answerPTOs = 8
+
+// maxAckDelay is quic-go's default max_ack_delay, which a live peer may wait before acknowledging.
+const maxAckDelay = 25 * time.Millisecond
+
+// answerTimeoutFor is how long a live peer may take to acknowledge anything sent to it, from quic-go's own PTO estimate.
+func answerTimeoutFor(stats quic.ConnectionStats, floor time.Duration) time.Duration {
+	pto := stats.SmoothedRTT + max(4*stats.MeanDeviation, time.Millisecond) + maxAckDelay
+	return max(floor, answerPTOs*pto)
+}
+
+// answerWatch closes a connection once data sent on it went unanswered, not even acknowledged, for longer than a live
+// server could take; quic-go's own idle timer would wait out the whole idle timeout.
+type answerWatch struct {
+	receive *receiveTracker
+	timeout func() time.Duration
+	expire  func(error)
+	// waiting is the monotonic time of the first send since the server was last heard from; the episode is open while it
+	// is past receive.lastMono.
+	waiting atomic.Int64
+	armed   atomic.Bool
+	access  sync.Mutex
+	timer   *time.Timer
+	closed  bool
+}
+
+func newAnswerWatch(receive *receiveTracker, timeout func() time.Duration, expire func(error)) *answerWatch {
+	return &answerWatch{receive: receive, timeout: timeout, expire: expire}
+}
+
+func (w *answerWatch) open() bool {
+	return w.waiting.Load() > w.receive.lastMono.Load()
+}
+
+// sent marks data handed to quic-go; only the first send of an unanswered episode touches the timer.
+func (w *answerWatch) sent() {
+	if w.open() {
+		return
+	}
+	w.waiting.Store(w.receive.clock().mono)
+	if w.armed.CompareAndSwap(false, true) {
+		w.schedule(w.timeout())
+	}
+}
+
+func (w *answerWatch) schedule(d time.Duration) {
+	w.access.Lock()
+	defer w.access.Unlock()
+	if w.closed {
+		return
+	}
+	if w.timer == nil {
+		w.timer = time.AfterFunc(d, w.fire)
+	} else {
+		w.timer.Reset(d)
+	}
+}
+
+func (w *answerWatch) fire() {
+	w.access.Lock()
+	if w.closed {
+		w.access.Unlock()
+		return
+	}
+	if w.open() {
+		timeout := w.timeout()
+		waited := time.Duration(w.receive.clock().mono - w.waiting.Load())
+		if waited < timeout {
+			w.timer.Reset(timeout - waited)
+			w.access.Unlock()
+			return
+		}
+		w.closed = true
+		w.access.Unlock()
+		w.expire(E.Cause(errNoAnswer, "nothing received for ", waited.Round(100*time.Millisecond), " after sending"))
+		return
+	}
+	w.armed.Store(false)
+	w.access.Unlock()
+	// A send that saw the timer still armed relies on it, so pick up an episode it opened meanwhile.
+	if w.open() && w.armed.CompareAndSwap(false, true) {
+		w.schedule(w.timeout())
+	}
+}
+
+func (w *answerWatch) close() {
+	w.access.Lock()
+	defer w.access.Unlock()
+	w.closed = true
+	if w.timer != nil {
+		w.timer.Stop()
+	}
+}
diff --git a/hysteria2/answer_test.go b/hysteria2/answer_test.go
new file mode 100644
index 0000000..34ccddd
--- /dev/null
+++ b/hysteria2/answer_test.go
@@ -0,0 +1,223 @@
+package hysteria2
+
+import (
+	"errors"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/quic-go"
+)
+
+func TestAnswerTimeoutFor(t *testing.T) {
+	for _, testCase := range []struct {
+		name  string
+		stats quic.ConnectionStats
+		want  time.Duration
+	}{
+		{"fast path keeps the floor", quic.ConnectionStats{SmoothedRTT: 80 * time.Millisecond, MeanDeviation: 10 * time.Millisecond}, minAnswerTimeout},
+		{"slow path scales", quic.ConnectionStats{SmoothedRTT: time.Second, MeanDeviation: 250 * time.Millisecond}, answerPTOs * (2*time.Second + maxAckDelay)},
+		{"jitter counts", quic.ConnectionStats{SmoothedRTT: 300 * time.Millisecond, MeanDeviation: 300 * time.Millisecond}, answerPTOs * (1500*time.Millisecond + maxAckDelay)},
+	} {
+		if got := answerTimeoutFor(testCase.stats, minAnswerTimeout); got != testCase.want {
+			t.Errorf("%s: %v, want %v", testCase.name, got, testCase.want)
+		}
+	}
+}
+
+func TestAnswerWatchEpisodes(t *testing.T) {
+	clock := &fakeClock{}
+	tracker := newReceiveTracker(clock.read, time.Minute)
+	var expired atomic.Int32
+	var lastErr atomic.Value
+	watch := newAnswerWatch(tracker, func() time.Duration { return 5 * time.Second }, func(err error) {
+		expired.Add(1)
+		lastErr.Store(err)
+	})
+	defer watch.close()
+
+	clock.advance(time.Second)
+	watch.sent()
+	start := watch.waiting.Load()
+	clock.advance(time.Second)
+	watch.sent()
+	if watch.waiting.Load() != start {
+		t.Fatal("a later send moved the start of an unanswered episode")
+	}
+
+	clock.advance(time.Second)
+	tracker.touch()
+	watch.fire()
+	if expired.Load() != 0 || watch.armed.Load() {
+		t.Fatal("an answered episode kept the watch armed or expired it")
+	}
+
+	clock.advance(time.Second)
+	watch.sent()
+	if watch.waiting.Load() <= tracker.lastMono.Load() || !watch.armed.Load() {
+		t.Fatal("a send after the answer did not open a new episode")
+	}
+	clock.advance(4 * time.Second)
+	watch.fire()
+	if expired.Load() != 0 {
+		t.Fatal("expired before the timeout")
+	}
+	clock.advance(time.Second)
+	watch.fire()
+	if expired.Load() != 1 {
+		t.Fatal("unanswered episode did not expire at the timeout")
+	}
+	if err, _ := lastErr.Load().(error); !errors.Is(err, errNoAnswer) {
+		t.Fatal("expired with another error: ", err)
+	}
+	watch.fire()
+	watch.sent()
+	if expired.Load() != 1 {
+		t.Fatal("watch acted after it expired")
+	}
+}
+
+func TestAnswerWatchIdleAndClose(t *testing.T) {
+	var expired atomic.Int32
+	idle := newAnswerWatch(newReceiveTracker(coarseClock, time.Minute), func() time.Duration { return 20 * time.Millisecond }, func(error) {
+		expired.Add(1)
+	})
+	defer idle.close()
+	closed := newAnswerWatch(newReceiveTracker(coarseClock, time.Minute), func() time.Duration { return 20 * time.Millisecond }, func(error) {
+		expired.Add(1)
+	})
+	closed.sent()
+	closed.close()
+	time.Sleep(200 * time.Millisecond)
+	if idle.armed.Load() || idle.timer != nil {
+		t.Fatal("a watch that never sent armed a timer")
+	}
+	if expired.Load() != 0 {
+		t.Fatal("a timer fired after close or without a send")
+	}
+	closed.sent()
+	if closed.timer.Stop() {
+		t.Fatal("a send after close rearmed the timer")
+	}
+}
+
+func newAnswerHarness(t *testing.T, salamanderPassword string, floor time.Duration) *staleHarness {
+	t.Helper()
+	h := newStaleHarness(t, salamanderPassword)
+	h.client.clock = coarseClock
+	h.client.answerFloor = floor
+	return h
+}
+
+func waitNoAnswer(t *testing.T, conn *clientQUICConnection, sentAt time.Time, floor time.Duration) {
+	t.Helper()
+	select {
+	case <-conn.connDone:
+	case <-time.After(floor + 5*time.Second):
+		t.Fatal("unanswered connection left open")
+	}
+	if !errors.Is(conn.connErr, errNoAnswer) {
+		t.Fatal("connection closed for another reason: ", conn.connErr)
+	}
+	if waited := time.Since(sentAt); waited < floor-50*time.Millisecond {
+		t.Fatalf("closed after %v, before the %v timeout", waited, floor)
+	}
+}
+
+func TestNoAnswerClosesAfterDatagram(t *testing.T) {
+	for _, variant := range staleVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			const floor = 500 * time.Millisecond
+			h := newAnswerHarness(t, variant.salamander, floor)
+			conn := h.offer(t)
+			session := h.listen(t)
+			echoPacket(t, session)
+			h.server.silence(conn.quicConn.LocalAddr())
+			sentAt := time.Now()
+			// One send and then only waiting, as an app does after a request.
+			if _, err := session.WriteTo([]byte("ping"), staleEchoDestination.UDPAddr()); err != nil {
+				t.Fatal(err)
+			}
+			waitNoAnswer(t, conn, sentAt, floor)
+			_ = session.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, _, err := session.ReadFrom(make([]byte, 64)); err == nil || errors.Is(err, os.ErrDeadlineExceeded) {
+				t.Fatal("UDP session outlived its unanswered connection: ", err)
+			}
+			if h.offer(t) == conn {
+				t.Fatal("unanswered connection offered again")
+			}
+		})
+	}
+}
+
+func TestNoAnswerClosesAfterStreamRequest(t *testing.T) {
+	for _, variant := range staleVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			const floor = 500 * time.Millisecond
+			h := newAnswerHarness(t, variant.salamander, floor)
+			conn := h.offer(t)
+			echoStream(t, h.dial(t))
+			h.server.silence(conn.quicConn.LocalAddr())
+			stream := h.dial(t)
+			sentAt := time.Now()
+			if _, err := stream.Write([]byte("request")); err != nil {
+				t.Fatal(err)
+			}
+			waitNoAnswer(t, conn, sentAt, floor)
+			_ = stream.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, err := stream.Read(make([]byte, 64)); err == nil || errors.Is(err, os.ErrDeadlineExceeded) {
+				t.Fatal("stream outlived its unanswered connection: ", err)
+			}
+		})
+	}
+}
+
+func TestNoAnswerKeepsIdleConnection(t *testing.T) {
+	const floor = 300 * time.Millisecond
+	h := newAnswerHarness(t, "", floor)
+	conn := h.offer(t)
+	echoPacket(t, h.listen(t))
+	h.server.silence(conn.quicConn.LocalAddr())
+	time.Sleep(6 * floor)
+	if !conn.active() || h.offer(t) != conn {
+		t.Fatal("idle connection closed although nothing was sent")
+	}
+}
+
+func TestNoAnswerKeepsSlowServer(t *testing.T) {
+	const floor = 800 * time.Millisecond
+	h := newAnswerHarness(t, "", floor)
+	conn := h.offer(t)
+	session := h.listen(t)
+	echoPacket(t, session)
+	h.server.setDelay(floor / 2)
+	for range 3 {
+		echoPacket(t, session)
+	}
+	if !conn.active() || h.offer(t) != conn {
+		t.Fatal("connection to a slow but live server closed: ", conn.connErr)
+	}
+}
+
+func TestNoAnswerTimeoutFollowsRTT(t *testing.T) {
+	const floor = 300 * time.Millisecond
+	h := newAnswerHarness(t, "", floor)
+	conn := h.offer(t)
+	session := h.listen(t)
+	echoPacket(t, session)
+	// Raise the delay in steps so the RTT estimate follows, then sit above the floor.
+	for delay := 50 * time.Millisecond; delay <= 2*floor; delay += 50 * time.Millisecond {
+		h.server.setDelay(delay)
+		echoPacket(t, session)
+	}
+	for range 3 {
+		echoPacket(t, session)
+	}
+	if !conn.active() || h.offer(t) != conn {
+		t.Fatal("a reply slower than the floor but within the RTT-based timeout closed the connection: ", conn.connErr)
+	}
+	if timeout := conn.answer.timeout(); timeout <= 2*floor {
+		t.Fatalf("timeout %v did not grow with the RTT", timeout)
+	}
+}
