+const stalePassword = "stale-test"
+
+var staleEchoDestination = M.ParseSocksaddr("198.51.100.1:7")
+
+type staleHarness struct {
+	ctx    context.Context
+	client *Client
+	clock  *fakeClock
+	server *silencingPacketConn
+}
+
+func newStaleHarness(t *testing.T, salamanderPassword string) *staleHarness {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	clientTLS, serverTLS := staleTLSConfigs(t)
+	udpConn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = udpConn.Close() })
+	server := &silencingPacketConn{PacketConn: udpConn, silenced: make(map[netip.AddrPort]bool)}
+	service, err := NewService[string](ServiceOptions{
+		Context:            ctx,
+		Logger:             logger.NOP(),
+		SalamanderPassword: salamanderPassword,
+		TLSConfig:          serverTLS,
+		UDPTimeout:         time.Minute,
+		Handler:            echoHandler{},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	service.UpdateUsers([]string{"user"}, []string{stalePassword})
+	if err = service.Start(server); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = service.Close() })
+	client, err := NewClient(ClientOptions{
+		Context:            ctx,
+		Dialer:             N.SystemDialer,
+		Logger:             logger.NOP(),
+		ServerAddress:      M.SocksaddrFromNet(udpConn.LocalAddr()),
+		SalamanderPassword: salamanderPassword,
+		Password:           stalePassword,
+		TLSConfig:          clientTLS,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	clock := &fakeClock{}
+	client.clock = clock.read
+	t.Cleanup(func() { _ = client.CloseWithError(os.ErrClosed) })
+	return &staleHarness{ctx: ctx, client: client, clock: clock, server: server}
+}
+
+func (h *staleHarness) offer(t *testing.T) *clientQUICConnection {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(h.ctx, 10*time.Second)
+	defer cancel()
+	conn, err := h.client.offer(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return conn
+}
+
+func (h *staleHarness) listen(t *testing.T) net.PacketConn {
+	t.Helper()
+	session, err := h.client.ListenPacket(h.ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = session.Close() })
+	return session
+}
+
+func (h *staleHarness) dial(t *testing.T) net.Conn {
+	t.Helper()
+	stream, err := h.client.DialConn(h.ctx, staleEchoDestination)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stream.Close() })
+	return stream
+}
+
+// untilStale sleeps the clock past staleAfter until probe sees it act; packets already in flight when the
+// server went silent may still freshen the connection once or twice.
+func (h *staleHarness) untilStale(t *testing.T, probe func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		h.clock.sleep(h.client.staleAfter + time.Second)
+		if probe() {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("connection never went stale")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func waitStaleClosed(t *testing.T, conn *clientQUICConnection) {
+	t.Helper()
+	select {
+	case <-conn.connDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("stale connection left open")
+	}
+	if !errors.Is(conn.connErr, errStaleConnection) {
+		t.Fatal("connection closed for another reason: ", conn.connErr)
+	}
+}
+
+func echoPacket(t *testing.T, session net.PacketConn) {
+	t.Helper()
+	if _, err := session.WriteTo([]byte("hello"), staleEchoDestination.UDPAddr()); err != nil {
+		t.Fatal(err)
+	}
+	_ = session.SetReadDeadline(time.Now().Add(5 * time.Second))
+	buffer := make([]byte, 64)
+	n, _, err := session.ReadFrom(buffer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(buffer[:n]) != "hello" {
+		t.Fatalf("echo %q", buffer[:n])
+	}
+}
+
+func echoStream(t *testing.T, stream net.Conn) {
+	t.Helper()
+	_ = stream.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := stream.Write([]byte("hello")); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 5)
+	if _, err := io.ReadFull(stream, buffer); err != nil {
+		t.Fatal(err)
+	}
+	if string(buffer) != "hello" {
+		t.Fatalf("echo %q", buffer)
+	}
+	_ = stream.SetDeadline(time.Time{})
+}
+
+type fakeClock struct {
+	access sync.Mutex
+	now    clockReading
+}
+
+func (c *fakeClock) read() clockReading {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return c.now
+}
+
+// advance passes time awake, which both clocks count.
+func (c *fakeClock) advance(d time.Duration) {
+	c.access.Lock()
+	c.now.boot += int64(d)
+	c.now.mono += int64(d)
+	c.access.Unlock()
+}
+
+// sleep passes time in device sleep, which only boottime counts.
+func (c *fakeClock) sleep(d time.Duration) {
+	c.access.Lock()
+	c.now.boot += int64(d)
+	c.access.Unlock()
+}
+
+func (c *fakeClock) stamped(tracker *receiveTracker) bool {
+	now := c.read()
+	return tracker.lastBoot.Load() == now.boot && tracker.lastMono.Load() == now.mono
+}
+
+// silencingPacketConn drops the server's packets to silenced clients, like a server that has forgotten them.
+type silencingPacketConn struct {
+	net.PacketConn
+	access   sync.RWMutex
+	silenced map[netip.AddrPort]bool
+}
+
+func (c *silencingPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	c.access.RLock()
+	silenced := c.silenced[M.SocksaddrFromNet(addr).Unwrap().AddrPort()]
+	c.access.RUnlock()
+	if silenced {
+		return len(p), nil
+	}
+	return c.PacketConn.WriteTo(p, addr)
+}
+
+func (c *silencingPacketConn) silence(addr net.Addr) {
+	c.access.Lock()
+	c.silenced[M.SocksaddrFromNet(addr).Unwrap().AddrPort()] = true
+	c.access.Unlock()
+}
+
+type echoHandler struct{}
+
+func (echoHandler) NewConnectionEx(_ context.Context, conn net.Conn, _ M.Socksaddr, _ M.Socksaddr, _ N.CloseHandlerFunc) {
+	defer conn.Close()
+	if N.ReportHandshakeSuccess(conn) != nil {
+		return
+	}
+	_, _ = io.Copy(conn, conn)
+}
+
+func (echoHandler) NewPacketConnectionEx(_ context.Context, conn N.PacketConn, _ M.Socksaddr, _ M.Socksaddr, _ N.CloseHandlerFunc) {
+	defer conn.Close()
+	for {
+		buffer := buf.NewPacket()
+		destination, err := conn.ReadPacket(buffer)
+		if err != nil {
+			buffer.Release()
+			return
+		}
+		if conn.WritePacket(buffer, destination) != nil {
+			return
+		}
+	}
+}
+
+type staleTLSConfig struct {
+	config *tls.Config
+}
+
+func staleTLSConfigs(t *testing.T) (client aTLS.Config, server aTLS.ServerConfig) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "hy2.test"},
+		DNSNames:     []string{"hy2.test"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certificate := tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+	return &staleTLSConfig{&tls.Config{ServerName: "hy2.test", InsecureSkipVerify: true}},
+		&staleTLSConfig{&tls.Config{Certificates: []tls.Certificate{certificate}}}
+}
