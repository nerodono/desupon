+				t.Fatal("stream outlived its stale connection: ", err)
+			}
+			echoPacket(t, h.listen(t))
+			echoStream(t, h.dial(t))
+		})
+	}
+}
+
+func TestStaleConnectionFailsStreamWrites(t *testing.T) {
+	for _, variant := range staleVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			h := newStaleHarness(t, variant.salamander)
+			conn := h.offer(t)
+			stream := h.dial(t)
+			echoStream(t, stream)
+			h.server.silence(conn.quicConn.LocalAddr())
+			var writeErr error
+			h.untilStale(t, func() bool {
+				_, writeErr = stream.Write([]byte("ping"))
+				return writeErr != nil
+			})
+			if !errors.Is(writeErr, errStaleConnection) {
+				t.Fatal("write failed for another reason: ", writeErr)
+			}
+			waitStaleClosed(t, conn)
+			echoStream(t, h.dial(t))
+		})
+	}
+}
