+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	aTLS "github.com/sagernet/sing/common/tls"
+)
+
+func TestStaleAfterFor(t *testing.T) {
+	for _, testCase := range []struct {
+		name   string
+		config *quic.Config
+		want   time.Duration
+	}{
+		{"hysteria default", &quic.Config{MaxIdleTimeout: hysteria.DefaultMaxIdleTimeout}, 20 * time.Second},
+		{"quic-go default", &quic.Config{}, 20 * time.Second},
+		{"long idle", &quic.Config{MaxIdleTimeout: time.Minute}, 40 * time.Second},
+		{"chrome parrot pins idle", &quic.Config{MaxIdleTimeout: time.Minute, ChromeParrot: true}, 20 * time.Second},
+		{"floor", &quic.Config{MaxIdleTimeout: 6 * time.Second}, minStaleAfter},
+	} {
+		if got := staleAfterFor(testCase.config); got != testCase.want {
+			t.Errorf("%s: %v, want %v", testCase.name, got, testCase.want)
+		}
+	}
+}
+
+func TestCoarseClockTracksKernel(t *testing.T) {
+	wall := time.Now().UnixNano()
+	for _, sample := range []*clockSample{
+		nil,
+		{wall: wall + int64(time.Hour)},
+		{wall: wall - int64(time.Hour)},
+	} {
+		lastClockSample.Store(sample)
+		// The first read must resample, the second extrapolates from it.
+		for range 2 {
+			before, monoBefore := boottime(), time.Since(monoBase)
+			coarse := coarseClock()
+			after, monoAfter := boottime(), time.Since(monoBase)
+			if coarse.boot < before-int64(5*time.Millisecond) || coarse.boot > after+int64(5*time.Millisecond) {
+				t.Fatalf("coarse boottime %d outside kernel reads [%d, %d] after sample %+v", coarse.boot, before, after, sample)
+			}
+			if coarse.mono < int64(monoBefore) || coarse.mono > int64(monoAfter) {
+				t.Fatalf("coarse monotonic %d outside reads [%d, %d]", coarse.mono, monoBefore, monoAfter)
+			}
+		}
+	}
+}
+
+func TestStaleErrorNeedsSleep(t *testing.T) {
+	clock := &fakeClock{}
+	tracker := newReceiveTracker(clock.read, 20*time.Second)
+	clock.sleep(15 * time.Second)
+	clock.advance(4 * time.Second)
+	if err := tracker.staleError(); err != nil {
+		t.Fatal("asleep, silence under staleAfter: ", err)
+	}
+
+	tracker.touch()
+	clock.advance(time.Minute)
+	clock.sleep(minAsleep - time.Millisecond)
+	if err := tracker.staleError(); err != nil {
+		t.Fatal("awake outage judged stale: ", err)
+	}
+	clock.sleep(time.Millisecond)
+	if err := tracker.staleError(); !errors.Is(err, errStaleConnection) {
+		t.Fatal("silence with sleep in it not stale: ", err)
+	}
+
+	tracker.touch()
+	clock.sleep(21 * time.Second)
+	if err := tracker.staleError(); !errors.Is(err, errStaleConnection) {
+		t.Fatal("sleep past staleAfter not stale: ", err)
+	}
+}
+
+func TestReceivePacketConnTracksReads(t *testing.T) {
+	clock := &fakeClock{}
+	tracker := newReceiveTracker(clock.read, time.Minute)
+	udpConn, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer udpConn.Close()
+	conn := &receivePacketConn{PacketConn: udpConn, receive: tracker}
+	if _, err = conn.SyscallConn(); err != nil {
+		t.Fatal("socket hidden from quic-go's fd path: ", err)
+	}
+	onRead, _ := conn.IOActivityFuncs()
+	clock.advance(time.Second)
+	onRead(1)
+	if !clock.stamped(tracker) {
+		t.Fatal("fd path read not tracked")
+	}
+	sender, err := net.DialUDP("udp", nil, udpConn.LocalAddr().(*net.UDPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sender.Close()
+	if _, err = sender.Write([]byte("x")); err != nil {
+		t.Fatal(err)
+	}
+	clock.advance(time.Second)
+	_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+	if _, _, err = conn.ReadFrom(make([]byte, 16)); err != nil {
+		t.Fatal(err)
+	}
+	if !clock.stamped(tracker) {
+		t.Fatal("ReadFrom not tracked")
+	}
+	opaque := &receivePacketConn{PacketConn: struct{ net.PacketConn }{udpConn}, receive: tracker}
+	if _, err = opaque.SyscallConn(); err == nil {
+		t.Fatal("SyscallConn invented a socket for a conn without one")
+	}
+}
+
+var staleVariants = []struct {
+	name       string
+	salamander string
+}{
+	// Plain UDP runs on quic-go's fd path, salamander on reads through the conn chain.
+	{"plain", ""},
+	{"salamander", "obfs"},
+}
+
+func TestStaleConnectionReused(t *testing.T) {
+	for _, variant := range staleVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			h := newStaleHarness(t, variant.salamander)
+			conn := h.offer(t)
+			session := h.listen(t)
+			for range 3 {
+				h.clock.sleep(h.client.staleAfter - time.Second)
+				if h.offer(t) != conn {
+					t.Fatal("fresh connection replaced")
+				}
+				// The reply restarts the silence, so the connection outlives staleAfter in total.
+				echoPacket(t, session)
+			}
+		})
+	}
+}
+
+func TestStaleConnectionReplaced(t *testing.T) {
+	for _, variant := range staleVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			h := newStaleHarness(t, variant.salamander)
+			conn := h.offer(t)
+			h.server.silence(conn.quicConn.LocalAddr())
+			var replacement *clientQUICConnection
+			h.untilStale(t, func() bool {
+				replacement = h.offer(t)
+				return replacement != conn
+			})
+			waitStaleClosed(t, conn)
+			if !replacement.active() {
+				t.Fatal("replacement connection inactive")
+			}
+			echoPacket(t, h.listen(t))
+		})
+	}
+}
+
+func TestAwakeSilenceKeepsConnection(t *testing.T) {
+	for _, variant := range staleVariants {
+		t.Run(variant.name, func(t *testing.T) {
+			h := newStaleHarness(t, variant.salamander)
+			conn := h.offer(t)
+			h.server.silence(conn.quicConn.LocalAddr())
+			h.clock.advance(2 * h.client.staleAfter)
+			if h.offer(t) != conn {
+				t.Fatal("connection replaced after a silence spent awake")
+			}
+			h.untilStale(t, func() bool {
+				return h.offer(t) != conn
+			})
+			waitStaleClosed(t, conn)
+		})
+	}
+}
+
+func TestStaleConnectionClosesSessions(t *testing.T) {
+	for _, variant := range staleVariants {
+		t.Run(variant.name, func(t *testing.T) {
