diff --git a/hysteria2/boottime_linux.go b/hysteria2/boottime_linux.go
new file mode 100644
index 0000000..3061447
--- /dev/null
+++ b/hysteria2/boottime_linux.go
@@ -0,0 +1,12 @@
+//go:build linux
+
+package hysteria2
+
+import "golang.org/x/sys/unix"
+
+func boottime() int64 {
+	var ts unix.Timespec
+	// CLOCK_BOOTTIME predates every kernel Go supports, so the call cannot fail.
+	_ = unix.ClockGettime(unix.CLOCK_BOOTTIME, &ts)
+	return ts.Nano()
+}
