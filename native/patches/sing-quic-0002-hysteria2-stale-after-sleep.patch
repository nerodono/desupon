diff --git a/hysteria2/stale.go b/hysteria2/stale.go
new file mode 100644
index 0000000..1be9dae
--- /dev/null
+++ b/hysteria2/stale.go
@@ -0,0 +1,167 @@
+package hysteria2
+
+import (
+	"errors"
+	"io"
+	"net"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/quic-go"
+	"github.com/sagernet/sing-quic/hysteria"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+)
+
+var errStaleConnection = E.New("connection is stale, the server has likely dropped it during device sleep")
+
+// minStaleAfter leaves room to retransmit a lost keepalive when the idle timeout is short.
+const minStaleAfter = 15 * time.Second
+
+// staleAfterFor sits at 2/3 of the idle timeout: above the idle/2 keepalive a healthy awake connection
+// always hears back from, below the point where the server, whose clock ran through the sleep, may have dropped it.
+func staleAfterFor(config *quic.Config) time.Duration {
+	idle := config.MaxIdleTimeout
+	if idle == 0 || config.ChromeParrot {
+		// quic-go's default and its Chrome-pinned value.
+		idle = hysteria.DefaultMaxIdleTimeout
+	}
+	return max(idle*2/3, minStaleAfter)
+}
+
+// minAsleep is the least sleep that makes a silence one quic-go's idle timer cannot see, well above coarseClock's skew;
+// a silence spent awake is a plain outage, which that timer still judges.
+const minAsleep = 2 * time.Second
+
+// clockReading pairs boottime, which runs on in device sleep, with the monotonic clock, which stops there as quic-go's timers do.
+type clockReading struct {
+	boot int64
+	mono int64
+}
+
+// receiveTracker times the server's silence on a clock that keeps running in device sleep, unlike quic-go's idle timer.
+type receiveTracker struct {
+	clock      func() clockReading
+	staleAfter time.Duration
+	lastBoot   atomic.Int64
+	lastMono   atomic.Int64
+}
+
+func newReceiveTracker(clock func() clockReading, staleAfter time.Duration) *receiveTracker {
+	tracker := &receiveTracker{clock: clock, staleAfter: staleAfter}
+	tracker.touch()
+	return tracker
+}
+
+func (t *receiveTracker) touch() {
+	now := t.clock()
+	t.lastBoot.Store(now.boot)
+	t.lastMono.Store(now.mono)
+}
+
+func (t *receiveTracker) count(int64) {
+	t.touch()
+}
+
+func (t *receiveTracker) staleError() error {
+	now := t.clock()
+	// Loaded in the reverse order of touch, so a racing receive can only shorten the silence.
+	lastMono := t.lastMono.Load()
+	silent := time.Duration(now.boot - t.lastBoot.Load())
+	if silent <= t.staleAfter {
+		return nil
+	}
+	asleep := silent - time.Duration(now.mono-lastMono)
+	if asleep < minAsleep {
+		return nil
+	}
+	return E.Cause(errStaleConnection, "nothing received for ", silent.Round(time.Second), ", ", asleep.Round(time.Second), " of it asleep")
+}
+
+// receiveConn stamps reads from the server socket; withSyscallConn unwraps it, so on quic-go's fd path the stamp runs as a read counter.
+type receiveConn struct {
+	net.Conn
+	receive *receiveTracker
+}
+
+func (c *receiveConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	if err == nil {
+		c.receive.touch()
+	}
+	return n, err
+}
+
+func (c *receiveConn) UnwrapReader() (io.Reader, []N.CountFunc) {
+	return c.Conn, []N.CountFunc{c.receive.count}
+}
+
+func (c *receiveConn) UnwrapWriter() (io.Writer, []N.CountFunc) {
+	return c.Conn, nil
+}
+
+var _ quic.IOActivityConn = (*receivePacketConn)(nil)
+
+// receivePacketConn stamps reads from the server socket, through ReadFrom or, on quic-go's fd path, its activity callback.
+type receivePacketConn struct {
+	net.PacketConn
+	receive *receiveTracker
+}
+
+func (c *receivePacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	n, addr, err := c.PacketConn.ReadFrom(p)
+	if err == nil {
+		c.receive.touch()
+	}
+	return n, addr, err
+}
+
+func (c *receivePacketConn) SyscallConn() (syscall.RawConn, error) {
+	conn, isSyscallConn := c.PacketConn.(syscall.Conn)
+	if !isSyscallConn {
+		return nil, errors.ErrUnsupported
+	}
+	return conn.SyscallConn()
+}
+
+func (c *receivePacketConn) IOActivityFuncs() (onRead func(size int), onWrite func(size int)) {
+	var upstreamRead func(size int)
+	if activityConn, isActivityConn := c.PacketConn.(quic.IOActivityConn); isActivityConn {
+		upstreamRead, onWrite = activityConn.IOActivityFuncs()
+	}
+	return func(size int) {
+		c.receive.touch()
+		if upstreamRead != nil {
+			upstreamRead(size)
+		}
+	}, onWrite
+}
+
+const clockResample = time.Second
+
+type clockSample struct {
+	wall int64
+	boot int64
+}
+
+var (
+	lastClockSample atomic.Pointer[clockSample]
+	monoBase        = time.Now()
+)
+
+// coarseClock extrapolates the last boottime reading along the vDSO wall clock, which also runs in sleep,
+// and re-reads it every second or on a backward step, so clock adjustments skew it by under a second.
+func coarseClock() clockReading {
+	now := time.Now()
+	wall := now.UnixNano()
+	mono := int64(now.Sub(monoBase))
+	if sample := lastClockSample.Load(); sample != nil {
+		if elapsed := wall - sample.wall; elapsed >= 0 && elapsed < int64(clockResample) {
+			return clockReading{boot: sample.boot + elapsed, mono: mono}
+		}
+	}
+	boot := boottime()
+	lastClockSample.Store(&clockSample{wall: wall, boot: boot})
+	return clockReading{boot: boot, mono: mono}
+}
